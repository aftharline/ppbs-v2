      radial-gradient(circle at center, rgba(15, 138, 107, 0.04) 0 1.5px, transparent 1.6px),
      linear-gradient(90deg, rgba(42, 39, 34, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(42, 39, 34, 0.05) 1px, transparent 1px);
    background-size: 38px 38px, 38px 38px, 76px 76px, 90px 90px, 90px 90px;
    background-position: 0 0, 19px 19px, 38px 38px, 0 0, 0 0;
    -webkit-mask-image: none;
    mask-image: none;
    opacity: 1;
