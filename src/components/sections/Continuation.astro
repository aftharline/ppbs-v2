<script>
  const modal = document.getElementById("register-modal") as HTMLDialogElement | null;
  const openers = document.querySelectorAll<HTMLElement>("[data-register-open]");
  const closers = document.querySelectorAll<HTMLElement>("[data-register-close]");

  openers.forEach((button) => {
    button.addEventListener("click", () => {
      if (modal?.showModal) modal.showModal();
    });
  });

  closers.forEach((button) => {
    button.addEventListener("click", () => modal?.close());
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) modal.close();
  });

  const archiveModal = document.getElementById("archive-modal") as HTMLDialogElement | null;
  const archiveBtn = document.getElementById("archive-btn") as HTMLButtonElement | null;
  const archiveClosers = document.querySelectorAll<HTMLElement>("[data-archive-close]");

  archiveBtn?.addEventListener("click", () => {
    if (archiveModal?.showModal) archiveModal.showModal();
  });

  archiveClosers.forEach((button) => {
    button.addEventListener("click", () => archiveModal?.close());
  });

  archiveModal?.addEventListener("click", (event) => {
    if (event.target === archiveModal) archiveModal.close();
  });

  const form = document.getElementById("collab-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const message = [
      "Halo *Putera Puteri Batik Surabaya*, saya ingin mengajukan kolaborasi.",
      "",
      `Nama: ${data.get("nama")}`,
      `Instansi/Komunitas: ${data.get("instansi")}`,
      `Kontak WhatsApp: ${data.get("kontak")}`,
      `Jenis Kolaborasi: ${data.get("jenis")}`,
      `Pesan: ${data.get("pesan")}`,
    ].join("\n");

    window.location.href = `https://wa.me/6285707109853/?text=${encodeURIComponent(message)}`;
  });
</script>
