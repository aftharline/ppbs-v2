---
/**
 * Continuation.astro - landing page lanjutan PPBS.
 * Mengisi anchor navbar, memperpanjang alur scroll, dan menjaga semua
 * interaksi tetap statis-ringan untuk performa Lighthouse.
 */
import GlassButton from "../ui/GlassButton.astro";
import Ornament from "../ui/Ornament.astro";
import CircularGallery from "../CircularGallery.astro";

const principles = [
  {
    num: "01",
    title: "Merawat akar",
    text: "Cerita, teknik, dan simbol batik Surabaya dijaga sebagai bahasa budaya yang bisa dipahami lintas generasi.",
  },
  {
    num: "02",
    title: "Menghidupkan kota",
    text: "Batik dibawa ke ruang publik melalui edukasi, perjumpaan kreatif, dan pengalaman budaya yang dekat dengan warga.",
  },
  {
    num: "03",
    title: "Menjadi teladan",
    text: "Putera-puteri dibentuk agar anggun dalam sikap, tajam dalam wawasan, dan siap menjadi wajah warisan Surabaya.",
  },
];

const traits = [
  "Berpengetahuan budaya",
  "Berani tampil dengan tutur halus",
  "Peka terhadap detail motif",
  "Mampu menghubungkan tradisi dan masa kini",
];

const journey = [
  {
    phase: "Temu",
    title: "Mengenal warisan",
    text: "Peserta memasuki cerita batik Surabaya melalui motif, tokoh, tempat, dan nilai yang membentuknya.",
  },
  {
    phase: "Latih",
    title: "Menajamkan diri",
    text: "Rangkaian kelas membentuk pembawaan, komunikasi, riset budaya, dan kepekaan visual.",
  },
  {
    phase: "Tampil",
    title: "Mewakili kota",
    text: "Finalis membawa narasi batik ke panggung, komunitas, dan agenda budaya Surabaya.",
  },
  {
    phase: "Terus",
    title: "Menjadi penjaga",
    text: "Para alumni bergerak sebagai jejaring muda yang merawat batik lewat karya dan pelayanan publik.",
  },
];

const programs = [
  {
    title: "Kelas Motif",
    text: "Sesi pembacaan motif khas Surabaya, dari simbol pesisir hingga karakter kota yang teguh.",
  },
  {
    title: "Ruang Tutur",
    text: "Pelatihan public speaking, story framing, dan cara menyampaikan warisan tanpa kehilangan jiwa.",
  },
  {
    title: "Jejak Kota",
    text: "Kunjungan budaya dan pemetaan titik batik untuk memahami Surabaya sebagai ruang hidup tradisi.",
  },
  {
    title: "Kolaborasi Kriya",
    text: "Pertemuan dengan perajin, kreator, dan komunitas untuk membuka peluang karya lintas generasi.",
  },
];

const logos = Array.from({ length: 36 }, (_, i) => ({
  src: `/partnership/${i + 2}.webp`,
  alt: `Mitra ${i + 2}`,
  width: 1000,
  height: 1000,
}));

const experiences = [
  "Workshop batik dan literasi motif untuk komunitas muda.",
  "Kurasi visual untuk kampanye budaya dan acara kota.",
  "Kolaborasi konten dengan perajin, sekolah, dan ruang kreatif.",
  "Panggung apresiasi untuk finalis dan alumni PPBS.",
];

const galleryItems = [
  { image: '/visuals/01.webp', text: 'Gelar Karya' },
  { image: '/visuals/02.webp', text: 'Motif Klasik' },
  { image: '/visuals/03.webp', text: 'Proses Kreatif' },
  { image: '/visuals/04.webp', text: 'Detail Goresan' },
  { image: '/visuals/05.webp', text: 'Kain Tradisi' },
  { image: '/visuals/06.webp', text: 'Pewarnaan Alami' },
  { image: '/visuals/07.webp', text: 'Sentuhan Akhir' },
  { image: '/visuals/08.webp', text: 'Koleksi Unggul' },
  { image: '/visuals/09.webp', text: 'Inspirasi Motif' },
  { image: '/visuals/10.webp', text: 'Karya Lestari' },
  { image: '/visuals/11.webp', text: 'Warisan Budaya' },
];
---

<section class="marquee-band" aria-label="Semboyan">
  <div class="marquee-track">
    {Array.from({ length: 3 }).map(() => (
      <div class="marquee-set" aria-hidden="true">
        <span>WUJUD TRESNA BUDHAYA AREK SURABAYA</span>
        <i></i>
        <span>SURABAYA JUARA</span>
        <i></i>
      </div>
    ))}
  </div>
</section>

<section class="vision section-shell" id="vision">
  <div class="section-inner vision-inner">
    <div class="section-kicker">
      <span class="t-eyebrow">Visi</span>
      <span class="section-num">02</span>
    </div>

    <div class="vision-copy">
      <h2 class="section-title">
        Warisan yang <span>berjalan</span>, bukan hanya dikenang.
      </h2>
      <p class="t-lead">
        PPBS hadir sebagai ruang pembentukan duta budaya muda yang mengerti
        akar batik Surabaya, berani membawanya ke hari ini, dan cukup peka
        untuk menjaga maknanya tetap utuh.
      </p>
    </div>

    <div class="principle-grid" data-reveal-group>
      {principles.map((item) => (
        <article class="principle-card">
          <span class="principle-num">{item.num}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="guardians section-shell" id="guardians">
  <div class="section-inner guardian-grid">
    <div class="guardian-visual" data-reveal id="tilted-card">
      <div class="tilted-card-inner">
        <img src="/figure.webp" alt="Sang Penjaga Batik Surabaya" loading="lazy" width="1385" height="924" />
        <div class="tilted-card-gradient" aria-hidden="true"></div>
        <div class="tilted-card-overlay">
          <span class="visual-badge">Sang Penjaga</span>
        </div>
      </div>
    </div>

    <div class="guardian-copy">
      <div class="section-kicker">
        <span class="t-eyebrow">Sang Penjaga</span>
        <span class="section-num">03</span>
      </div>
      <h2 class="section-title">
        Hadir dengan <span>wibawa</span>, bergerak dengan makna.
      </h2>
      <p class="t-body">
        Figur Sang Penjaga menjadi citra utama PPBS: sosok muda yang tidak
        sekadar mengenakan batik, tetapi mampu membaca, menjelaskan, dan
        menghidupkan nilai di baliknya.
      </p>

      <ul class="trait-list" data-reveal-group>
        {traits.map((trait) => (
          <li>
            <span aria-hidden="true"></span>
            {trait}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="journey section-shell" id="journey">
  <div class="section-inner">
    <div class="section-kicker">
      <span class="t-eyebrow">Perjalanan</span>
      <span class="section-num">04</span>
    </div>
    <div class="journey-head">
      <h2 class="section-title">Dari rasa ingin tahu menuju panggung budaya.</h2>
      <p class="t-body">
        Setiap tahap dirancang sebagai proses bertumbuh: peserta belajar,
        berlatih, hadir, lalu kembali memberi dampak.
      </p>
    </div>

    <div class="journey-line" data-reveal-group>
      {journey.map((item) => (
        <article class="journey-step">
          <span class="step-phase">{item.phase}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="programs section-shell" id="programs">
  <div class="section-inner programs-inner">
    <div class="programs-title">
      <div class="section-kicker">
        <span class="t-eyebrow">Program</span>
        <span class="section-num">05</span>
      </div>
      <h2 class="section-title">
        Ruang belajar yang <span>membentuk</span> rasa, suara, dan sikap.
      </h2>
    </div>

    <div class="program-grid" data-reveal-group>
      {programs.map((program, i) => (
        <article class="program-card">
          <span>{String(i + 1).padStart(2, "0")}</span>
          <h3>{program.title}</h3>
          <p>{program.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="motif-lab section-shell">
  <div class="section-inner motif-inner">
    <div>
      <span class="t-eyebrow">Arsip Motif</span>
      <h2 class="section-title">Setiap garis menyimpan <span>alamat pulang</span>.</h2>
    </div>
    <div class="motif-archive-cta">
      <button class="archive-btn" id="archive-btn" type="button">
        <span class="archive-btn-bg" aria-hidden="true"></span>
        <span class="archive-btn-shine" aria-hidden="true"></span>
        <span class="archive-btn-content">
          <svg class="archive-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <span class="archive-btn-label">Masuk ke Galeri Batik Surabaya</span>
          <svg class="archive-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </button>
    </div>
  </div>
</section>

<dialog class="archive-modal" id="archive-modal" aria-labelledby="archive-modal-title">
  <div class="modal-sigil" aria-hidden="true"></div>
  <button class="modal-close" type="button" data-archive-close aria-label="Tutup">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <span class="t-eyebrow">Galeri Batik</span>
  <h2 id="archive-modal-title">Segera Hadir</h2>
  <p>
    Galeri Batik Surabaya sedang dalam tahap pengembangan dan akan segera hadir.
    Nantikan ruang digital yang akan menampilkan koleksi motif, sejarah, dan
    cerita di balik setiap helai batik Surabaya.
  </p>
  <button class="modal-action" type="button" data-archive-close>Siap, saya tunggu</button>
</dialog>

<section class="living section-shell">
  <div class="section-inner living-inner">
    <div class="living-copy">
      <span class="t-eyebrow">Pengalaman</span>
      <h2 class="section-title">Batik terasa hidup saat disentuh banyak tangan.</h2>
    </div>
    <div class="living-list" data-reveal-group>
      {experiences.map((item, i) => (
        <article>
          <span>{String(i + 1).padStart(2, "0")}</span>
          <p>{item}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Filosofi Logo -->
<section class="logo-philosophy section-shell" id="logo-philosophy">
  <div class="section-inner logo-philosophy-inner">
    <div class="section-kicker">
      <span class="t-eyebrow">Filosofi Logo</span>
      <span class="section-num">06</span>
    </div>

    <div class="logo-philosophy-grid" data-reveal-group>
      <div class="logo-philosophy-copy">
        <h2 class="section-title">
          Logo yang <span>berbicara</span> lewat bentuk dan rasa.
        </h2>
        <p class="t-lead">
          Logo PPBS adalah ringkasan nilai: keteguhan, kehangatan, dan
          disiplin dalam merawat tradisi. Garis dan komposisinya dibuat
          agar mudah dibaca, namun tetap menyimpan jejak makna batik
          Surabaya.
        </p>
        <p class="t-body">
          Filosofi ini hadir bukan sebagai hiasan, melainkan pegangan
          perjalanan para Putera Puteri untuk menjadi wajah warisan kota yang
          relevan di masa kini.
        </p>
      </div>

      <div class="logo-philosophy-display" data-reveal>
        <div class="logo-display-frame" aria-hidden="true" style="border-radius: 0;"></div>
        <img
          src="/logo.svg"
          alt="Logo Putera Puteri Batik Surabaya"
          loading="lazy"
          decoding="async"
          width="286"
          height="286"
        />
        <span class="logo-display-caption">Logo Paguyuban Putera Puteri Batik Surabaya</span>
      </div>
    </div>
  </div>
</section>

<section class="gallery section-shell" id="gallery">
  <div class="section-inner">
    <div class="gallery-head">
      <div>
        <span class="t-eyebrow">Galeri</span>
        <h2 class="section-title">Fragmen visual dari napas batik Surabaya.</h2>
      </div>
      <p class="t-body">
        Potongan gambar dari narasi pembuka menjadi jendela untuk rasa, warna,
        dan ritme yang membentuk pengalaman PPBS.
      </p>
    </div>

    <CircularGallery
      items={galleryItems}
      bend={3}
      textColor="#ffffff"
      borderRadius={0.05}
      font="italic 500 18px Fraunces"
      scrollSpeed={2}
      scrollEase={0.05}
    />
  </div>
</section>

<section class="collaboration section-shell" id="collaboration">
  <div class="section-inner collab-inner">
    <div class="collab-copy">
      <span class="t-eyebrow">Kolaborasi</span>
      <h2 class="section-title">Punya ruang, acara, atau gagasan budaya?</h2>
      <p class="t-body">
        Ceritakan kebutuhanmu. Form ini akan membuka WhatsApp dengan pesan
        yang sudah tersusun rapi sesuai data yang diisi.
      </p>
    </div>

    <form class="collab-form" id="collab-form">
      <label>
        <span>Nama</span>
        <input name="nama" autocomplete="name" required />
      </label>
      <label>
        <span>Instansi / Komunitas</span>
        <input name="instansi" autocomplete="organization" required />
      </label>
      <label>
        <span>Kontak WhatsApp</span>
        <input name="kontak" inputmode="tel" autocomplete="tel" required />
      </label>
      <label>
        <span>Jenis Kolaborasi</span>
        <select name="jenis" required>
          <option value="">Pilih salah satu</option>
          <option>Workshop batik</option>
          <option>Acara budaya</option>
          <option>Konten kreatif</option>
          <option>Kolaborasi brand</option>
          <option>Lainnya</option>
        </select>
      </label>
      <label class="field-wide">
        <span>Pesan</span>
        <textarea name="pesan" rows="4" required></textarea>
      </label>
      <button class="collab-submit" type="submit" data-cursor data-magnetic>
        Kirim ke WhatsApp
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>
  </div>
</section>

<section class="structure section-shell" id="structure">
  <div class="section-inner structure-inner">
    <div class="section-kicker">
      <span class="t-eyebrow">Struktur</span>
      <span class="section-num">07</span>
    </div>
    <h2 class="section-title structure-title">
      Struktur <span>Kepengurusan</span>
    </h2>
    <p class="t-body structure-desc">
      Susunan organisasi Putera Puteri Batik Surabaya yang menjadi tulang punggung gerakan budaya.
    </p>
    <div class="org-chart">
      <div class="org-node org-director">
        <span class="org-label">Dewan Direksi</span>
      </div>
      <div class="org-line-v"></div>

      <div class="org-node org-advisor">
        <span class="org-label">Dewan Penasihat</span>
      </div>
      <div class="org-line-v"></div>

      <div class="org-node org-root">
        <span class="org-label">Ketua Umum</span>
      </div>
      <div class="org-line-v"></div>

      <div class="org-row org-row-1">
        <div class="org-node">
          <span class="org-label">Wakil Ketua Umum</span>
        </div>
      </div>
      <div class="org-line-v"></div>

      <div class="org-row org-row-2">
        <div class="org-node">
          <span class="org-label">Sekretaris</span>
        </div>
        <div class="org-line-h"></div>
        <div class="org-node">
          <span class="org-label">Bendahara</span>
        </div>
      </div>
      <div class="org-line-v"></div>

      <div class="org-node org-division-head">
        <span class="org-label">Kepala Divisi</span>
      </div>
      <div class="org-line-v"></div>

      <div class="org-row org-row-grid">
        <div class="org-division">
          <div class="org-division-name">Divisi Organisasi &amp; Keanggotaan</div>
          <div class="org-sub">Koordinator</div>
          <div class="org-sub-sub">Anggota</div>
        </div>
        <div class="org-division">
          <div class="org-division-name">Divisi Humas &amp; Kemitraan</div>
          <div class="org-sub">Koordinator</div>
          <div class="org-sub-sub">Anggota</div>
        </div>
        <div class="org-division">
          <div class="org-division-name">Divisi Pelestarian &amp; Pengembangan Batik</div>
          <div class="org-sub">Koordinator</div>
          <div class="org-sub-sub">Anggota</div>
        </div>
        <div class="org-division">
          <div class="org-division-name">Divisi Pendidikan &amp; Pelatihan</div>
          <div class="org-sub">Koordinator</div>
          <div class="org-sub-sub">Anggota</div>
        </div>
        <div class="org-division">
          <div class="org-division-name">Divisi Sosial &amp; Pengabdian Masyarakat</div>
          <div class="org-sub">Koordinator</div>
          <div class="org-sub-sub">Anggota</div>
        </div>
        <div class="org-division">
          <div class="org-division-name">Divisi Dana &amp; Usaha</div>
          <div class="org-sub">Koordinator</div>
          <div class="org-sub-sub">Anggota</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="partnership section-shell" id="partnership">
  <div class="section-inner partnership-inner">
    <div class="section-kicker">
      <span class="t-eyebrow">Mitra Kami</span>
      <span class="section-num">08</span>
    </div>
    <h2 class="section-title partnership-title">
      Berkolaborasi dengan <span>puluhan</span> mitra dari berbagai sektor.
    </h2>
    <p class="t-body partnership-desc">
      Kami bangga bekerja sama dengan institusi pendidikan, pemerintah, komunitas budaya,
      dan merek lokal yang turut merawat batik Surabaya.
    </p>
  </div>
  <div class="partnership-grid" aria-label="Logo mitra">
    {logos.map((logo) => (
      <div class="partner-card">
        <img
          src={logo.src}
          alt={logo.alt}
          loading="lazy"
          decoding="async"
          width={logo.width}
          height={logo.height}
          class="partner-logo"
        />
      </div>
    ))}
  </div>
</section>

<section class="register section-shell" id="register">
  <div class="section-inner register-inner" data-reveal>
    <Ornament variant="rule" />
    <span class="t-eyebrow">Pendaftaran</span>
    <h2 class="register-title">
      Saatnya membawa batik Surabaya dengan suara generasimu.
    </h2>
    <p class="t-lead">
      Jadilah bagian dari Putera Puteri Batik Surabaya dan ambil peran dalam
      menjaga warisan kota dengan cara yang hidup, hangat, dan relevan.
    </p>
    <div class="register-actions">
      <GlassButton variant="solid" class="register-open" type="button" data-register-open>
        Daftar Sekarang
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </GlassButton>
      <GlassButton variant="ghost" href="#about" data-cursor>
        Kembali ke Awal
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
      </GlassButton>
    </div>
  </div>
</section>

<dialog class="register-modal" id="register-modal" aria-labelledby="register-modal-title">
  <div class="modal-sigil" aria-hidden="true"></div>
  <button class="modal-close" type="button" data-register-close aria-label="Tutup">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <span class="t-eyebrow">Informasi</span>
  <h2 id="register-modal-title">Pemilihan berikutnya dibuka tahun depan.</h2>
  <p>
    Terima kasih sudah siap menjadi bagian dari Putera Puteri Batik Surabaya.
    Untuk saat ini, pendaftaran belum dibuka. Nantikan pemilihan PPBS
    selanjutnya di tahun depan.
  </p>
  <button class="modal-action" type="button" data-register-close>Siap, saya tunggu</button>
</dialog>

<footer class="site-footer">
  <div class="footer-marquee" aria-hidden="true">
    <span>SURABAYA JUARA</span>
    <span>MENJAGA WARISAN</span>
    <span>MENGINSPIRASI GENERASI</span>
  </div>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-brand-text">
        <span>Putera Puteri</span>
        <strong>Batik Surabaya</strong>
      </div>
      <div class="footer-brand-logo" aria-hidden="true">
        <img src="/logo.png" alt="" loading="lazy" decoding="async" width="64" height="64" />
      </div>
    </div>

    <div class="footer-grid">
      <div>
        <h3>Ruang Budaya</h3>
        <p>Surabaya, Indonesia</p>
        <p>Wujud tresna budaya arek Surabaya.</p>
      </div>
      <div>
        <h3>Jelajah</h3>
        <a href="#vision">Visi</a>
        <a href="#programs">Program</a>
        <a href="#collaboration">Kolaborasi</a>
      </div>
      <div>
        <h3>Semboyan</h3>
        <p>Menjaga Warisan.</p>
        <p>Menginspirasi Generasi.</p>
      </div>
    </div>

  </div>

  <div class="footer-credit">
    <span>Kontak Developer:</span>
    <a
      href="https://landingpage-porto-fatih.vercel.app"
      target="_blank"
      rel="noreferrer"
    >
      Muhammad Fatih
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7"/><path d="M10 14L21 3"/><path d="M21 14v7H3V3h7"/></svg>
    </a>
  </div>
</footer>


<style>
.marquee-band {
    overflow: hidden;
    padding: 1rem 0;
    border-top: 1px solid rgba(212, 175, 55, 0.18);
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    background: linear-gradient(180deg, rgba(12,12,10,1), rgba(10,10,9,1));
    position: relative;
  }
  :global([data-theme="light"]) .marquee-band {
    background: var(--color-ink-2);
    border-color: rgba(184, 134, 11, 0.25);
  }

  .marquee-band::before {
    content: "";
    position: absolute;
    inset: -2px;
    background:
      radial-gradient(1200px 120px at 50% 50%, rgba(212,175,55,0.10), transparent 60%),
      linear-gradient(90deg, transparent, rgba(246,241,233,0.05), transparent);
    opacity: 0.9;
    pointer-events: none;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-flow 22s linear infinite;
    position: relative;
    z-index: 1;
  }

  .marquee-track:nth-child(even) {
    animation-duration: 26s;
  }

  .marquee-set {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.2rem);
    padding-right: clamp(1rem, 2.5vw, 2.2rem);
    color: rgba(212, 175, 55, 0.95);
    font-family: var(--font-serif);
  }
    font-size: clamp(0.88rem, 1.7vw, 1.25rem);
    font-weight: 850;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 0 28px rgba(212,175,55,0.18);
  }

  .marquee-set span {
    background: linear-gradient(180deg, rgba(255,245,212,1), rgba(244,216,120,0.9));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  :global([data-theme="light"]) .marquee-set {
    color: #b8860b;
    text-shadow: none;
  }
  :global([data-theme="light"]) .marquee-set span {
    background: linear-gradient(135deg, #dfb840, #b8860b 50%, #8b6914);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .marquee-set i {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.65;
    box-shadow: 0 0 22px rgba(212,175,55,0.18);
  }

  @keyframes marquee-flow {
    0% { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }

  .principle-card,
  .program-card,
  .journey-step,
  .living-list article {
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .principle-card:hover,
  .program-card:hover,
  .journey-step:hover,
  .living-list article:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px -16px rgba(0, 0, 0, 0.3);
  }

