---
/**
 * About.astro — bagian pembuka konten (Bahasa Indonesia).
 * Latar kaya (gradien + motif batik subtle + garis emas dekoratif),
 * tipografi besar, paragraf rata kanan-kiri (justify).
 */
import Ornament from "../ui/Ornament.astro";
---

<section class="about" id="about">
  <!-- Lapisan dekoratif latar -->
  <div class="about-bg" aria-hidden="true">
    <div class="bg-glow bg-glow-a" data-parallax="0.08"></div>
    <div class="bg-glow bg-glow-b" data-parallax="-0.06"></div>
    <div class="bg-motif" data-parallax="0.04"></div>
    <div class="bg-grid"></div>
  </div>

  <div class="about-inner">
    <div class="about-head">
      <span class="t-eyebrow">Warisan Budaya</span>
      <span class="head-num">01</span>
    </div>

    <h2 class="about-title">
      Di mana <span class="italic">motif</span> menjadi <span class="accent">kenangan.</span>
    </h2>

    <div class="about-grid">
      <p class="t-lead about-lead">
        Putera Puteri Batik Surabaya adalah arsip hidup tradisi batik
        kota ini — titik temu antara tangan yang menggores, simbol yang
        berbicara, dan generasi yang menurunkannya.
      </p>
      <p class="t-body about-body">
        Dari kesabaran butiran <em>Sawunggaling</em> hingga kebanggaan
        tenang <em>Semanggi</em>, setiap pola membawa watak Surabaya:
        berani, murah hati, dan tak gentar. Inilah tanah tempat Sang
        Penjaga berdiri — dan cerita yang akan terus diteruskan oleh
        generasi berikutnya.
      </p>
    </div>

    <div class="about-rule" data-reveal></div>

    <!-- Segel ornamen batik (signature) -->
    <div class="about-seal" data-reveal>
      <Ornament variant="seal" />
    </div>

    <!-- Pita statistik -->
    <div class="about-stats" data-reveal>
      <div class="stat">
        <span class="stat-num">16</span>
        <span class="stat-label">Generasi Pewaris</span>
      </div>
      <span class="stat-sep" aria-hidden="true"></span>
      <div class="stat">
        <span class="stat-num">12+</span>
        <span class="stat-label">Motif Khas</span>
      </div>
      <span class="stat-sep" aria-hidden="true"></span>
      <div class="stat">
        <span class="stat-num">1</span>
        <span class="stat-label">Kota, Surabaya</span>
      </div>
    </div>

    <p class="about-continuation t-body">
      Dari ruang inilah PPBS menata cara baru untuk merawat batik Surabaya:
      tidak berhenti sebagai kain, tetapi tumbuh sebagai bahasa, sikap, dan
      panggilan untuk hadir di tengah kota.
    </p>
  </div>
</section>

<style>
  .about {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 16vh, 12rem) clamp(1.25rem, 5vw, 3rem) clamp(5rem, 12vh, 9rem);
    z-index: 1;
    background:
      radial-gradient(120% 80% at 80% 0%, rgba(212, 175, 55, 0.06), transparent 55%),
      radial-gradient(100% 70% at 0% 100%, rgba(15, 138, 107, 0.05), transparent 60%),
      var(--color-ink-2);
  }

  /* ===== Lapisan dekoratif ===== */
  .about-bg { position: absolute; inset: 0; pointer-events: none; }
  .bg-glow { position: absolute; border-radius: 50%; filter: blur(90px); }
  .bg-glow-a {
    width: 50vw; height: 50vw; max-width: 720px; max-height: 720px;
    top: -15%; right: -10%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.16), transparent 70%);
  }
  .bg-glow-b {
    width: 45vw; height: 45vw; max-width: 640px; max-height: 640px;
    bottom: -20%; left: -12%;
    background: radial-gradient(circle, rgba(15, 138, 107, 0.13), transparent 70%);
  }
  /* Motif batik subtle — pola simetris dari radial dots */
  .bg-motif {
    position: absolute; inset: 0;
    opacity: 0.5;
    background-image:
      radial-gradient(circle at center, rgba(212, 175, 55, 0.10) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at center, rgba(212, 175, 55, 0.06) 0 1px, transparent 1.1px);
    background-size: 38px 38px, 38px 38px;
    background-position: 0 0, 19px 19px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 30%, #000 30%, transparent 80%);
    mask-image: radial-gradient(120% 90% at 50% 30%, #000 30%, transparent 80%);
  }
  /* Grid garis tipis */
  .bg-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(246,241,233,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(246,241,233,0.025) 1px, transparent 1px);
    background-size: 90px 90px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 25%, #000 75%, transparent);
  }

  /* ===== Konten ===== */
  .about-inner { position: relative; max-width: 1200px; margin: 0 auto; }
  .about-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }
  .head-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    color: rgba(212, 175, 55, 0.4);
  }

  .about-title {
    font-size: clamp(1.8rem, 4.5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 16ch;
    font-variation-settings: "opsz" 144, "SOFT" 30;
  }
  .about-title .italic {
    font-style: italic;
    font-weight: 300;
    font-variation-settings: "opsz" 144, "SOFT" 60, "WONK" 1;
    color: var(--color-gold);
  }
  .about-title .accent {
    font-weight: 700;
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
    background: linear-gradient(120deg, #f6e6a8, var(--color-gold) 50%, var(--color-bronze));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #f4d878;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    max-width: 920px;
  }
  .about-lead { max-width: 38ch; }
  .about-body {
    max-width: 44ch;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }
  .about-body em {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 500;
  }

  .about-rule {
    height: 1px;
    width: 100%;
    margin: clamp(3rem, 6vw, 5rem) 0;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.45), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.4s var(--ease-lux);
  }
  .about-rule.is-in { transform: scaleX(1); }

  /* Segel ornamen */
  .about-seal {
    display: flex;
    justify-content: center;
    margin: clamp(2.5rem, 5vw, 4rem) 0;
    opacity: 0;
    transform: scale(0.85) translateY(20px);
    transition: opacity 1s var(--ease-lux), transform 1s var(--ease-lux);
  }
  .about-seal.is-in { opacity: 1; transform: none; }

  /* ===== Statistik ===== */
  .about-stats {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s var(--ease-lux) 0.2s, transform 0.9s var(--ease-lux) 0.2s;
  }
  .about-stats.is-in { opacity: 1; transform: none; }
  .stat { display: flex; flex-direction: column; gap: 0.3rem; }
  .stat-num {
    font-family: var(--font-serif);
    font-weight: 600;
    font-variation-settings: "opsz" 144, "WONK" 1;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1;
    color: var(--color-ivory);
  }
  .stat-label {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ivory-dim);
  }
  .stat-sep { width: 1px; height: 44px; background: rgba(212, 175, 55, 0.25); }

  .about-continuation { margin-top: clamp(3rem, 6vw, 5rem); max-width: 50ch; text-align: justify; }

  @media (max-width: 768px) {
    .about { padding: clamp(4.5rem, 14vh, 7rem) 1.25rem clamp(4rem, 10vh, 6rem); }
    .about-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .about-lead, .about-body { max-width: 100%; }
    .about-title { font-size: clamp(1.9rem, 9vw, 2.8rem); line-height: 1.1; }
    .about-stats {
      gap: 1.2rem;
      justify-content: space-between;
      width: 100%;
    }
    .stat-sep { display: none; }
    .stat-num { font-size: clamp(1.8rem, 8vw, 2.6rem); }
    .about-head { margin-bottom: 1rem; }
  }
  @media (max-width: 390px) {
    .about-stats { gap: 0.8rem; }
    .stat-label { font-size: 0.62rem; letter-spacing: 0.15em; }
  }
</style>

<script>
  // Reveal-on-scroll untuk divider & statistik.
  const revealables = document.querySelectorAll<HTMLElement>(
    ".about-rule[data-reveal], .about-stats[data-reveal], .about-seal[data-reveal]"
  );
  
  // ARIA live region for screen reader announcements
  const liveRegion = document.createElement('div');
  liveRegion.setAttribute('role', 'status');
  liveRegion.setAttribute('aria-live', 'polite');
  liveRegion.setAttribute('aria-atomic', 'true');
  liveRegion.className = 'sr-only';
  liveRegion.style.cssText = 'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0';
  document.body.appendChild(liveRegion);

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
            // Announce to screen readers
            if (e.target.classList.contains('about-rule')) {
              liveRegion.textContent = 'Bagian Warisan Budaya selesai dimuat';
            } else if (e.target.classList.contains('about-stats')) {
              liveRegion.textContent = 'Statistik: 16 Generasi Pewaris, 12+ Motif Khas, 1 Kota Surabaya';
            } else if (e.target.classList.contains('about-seal')) {
              liveRegion.textContent = 'Segel ornamen batik dimuat';
            }
          }
        });
      },
      { threshold: 0.3 }
    );
    revealables.forEach((el) => io.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add("is-in"));
  }
</script>
