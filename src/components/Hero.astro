---
import GlassButton from "./ui/GlassButton.astro";
import Ornament from "./ui/Ornament.astro";
---

<section class="hero-canvas-container" id="hero">
  <div class="hero-bg-layer" aria-hidden="true">
    <div class="hero-glow hero-glow-a" id="hero-glow-a"></div>
    <div class="hero-glow hero-glow-b" id="hero-glow-b"></div>
    <div class="hero-glow hero-glow-c" id="hero-glow-c"></div>
    <div class="hero-ambient-shift"></div>
    <div class="hero-motif-dots"></div>
    <div class="hero-sheen"></div>
  </div>

  <canvas id="motif-canvas" role="img" aria-label="Animasi partikel membentuk motif batik Surabaya"></canvas>

  <audio id="soundtrack" src="/soundtrack.mp3" loop preload="auto"></audio>

  <div class="hero-gradient-overlay"></div>

  <div class="hero-content">
    <div class="hero-text-wrapper">
      <div class="hero-eyebrow-wrapper animate-fade-in-up delay-1">
        <span class="hero-eyebrow-line" aria-hidden="true"></span>
        <span class="hero-eyebrow">Pusaka yang Terus Berjalan</span>
        <span class="hero-eyebrow-line" aria-hidden="true"></span>
      </div>
      
      <h1 class="hero-title">
        <span class="title-decor" aria-hidden="true">
          <span class="decor-dot"></span>
          <span class="decor-dash"></span>
        </span>
        <span class="title-line animate-glowing-type">
          <span class="title-char">M</span><span class="title-char">e</span><span class="title-char">n</span><span class="title-char">y</span><span class="title-char">u</span><span class="title-char">l</span><span class="title-char">a</span><span class="title-char">m</span>
        </span>
        <br />
        <span class="title-line animate-glowing-type delay-2">
          <span class="italic-accent">Jiwa</span>
          <span class="title-accent-space"> </span>
          <span class="title-char">K</span><span class="title-char">o</span><span class="title-char">t</span><span class="title-char">a</span>
        </span>
      </h1>
      
      <div class="hero-subtitle-wrapper animate-fade-in-up delay-4">
        <span class="subtitle-icon" aria-hidden="true"></span>
        <p class="hero-subtitle">
          Setiap titik cahaya adalah bagian dari cerita. Bergerak, terpecah, 
          namun pada akhirnya akan selalu kembali membentuk jati diri kota.
        </p>
        <span class="subtitle-icon" aria-hidden="true"></span>
      </div>

      <div class="hero-cta animate-fade-in-up delay-5">
        <GlassButton variant="solid" href="#bridge" data-cursor>
          Ikuti Perjalanan
        </GlassButton>
      </div>

      <!-- <div class="hero-scroll-indicator animate-fade-in delay-6">
        <div class="mouse"></div>
        <span>Mulai Menjelajah</span>
      </div> -->
    </div>

    <div class="hero-corner-decor hero-corner-tl" aria-hidden="true"></div>
    <div class="hero-corner-decor hero-corner-tr" aria-hidden="true"></div>
    <div class="hero-corner-decor hero-corner-bl" aria-hidden="true"></div>
    <div class="hero-corner-decor hero-corner-br" aria-hidden="true"></div>
  </div>
</section>

<section class="bridge-section" id="bridge" aria-label="Penghubung">
  <div class="bridge-bg-layer" aria-hidden="true">
    <div class="bridge-glow"></div>
    <div class="bridge-motif-dots"></div>
    <div class="bridge-grid"></div>
  </div>
  <div class="bridge-inner">
    <div class="bridge-ornament">
      <Ornament variant="seal" />
    </div>
    <p class="bridge-text">
      Dari partikel yang menari, lahirlah makna yang merapat.
    </p>
    <div class="bridge-rule" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero-canvas-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background-color: #070707;
    transition: background-color 0.8s ease;
    will-change: background-color;
  }

  :global([data-theme="light"]) .hero-canvas-container {
    background-color: #e8e0d6;
  }

  .hero-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    will-change: transform;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-glow-a {
    width: 60vw; height: 60vw;
    max-width: 900px; max-height: 900px;
    top: -25%; right: -20%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.2), transparent 70%);
  }
  .hero-glow-b {
    width: 55vw; height: 55vw;
    max-width: 800px; max-height: 800px;
    bottom: -30%; left: -20%;
    background: radial-gradient(circle, rgba(15, 138, 107, 0.14), transparent 70%);
  }
  :global([data-theme="light"]) .hero-glow-a {
    background: radial-gradient(circle, rgba(212, 175, 55, 0.1), transparent 70%);
  }
  :global([data-theme="light"]) .hero-glow-b {
    background: radial-gradient(circle, rgba(15, 138, 107, 0.07), transparent 70%);
  }
  .hero-glow-c {
    width: 40vw; height: 40vw;
    max-width: 600px; max-height: 600px;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(212, 175, 55, 0.06), transparent 60%);
    animation: glowPulse 6s ease-in-out infinite alternate;
  }
  :global([data-theme="light"]) .hero-glow-c {
    background: radial-gradient(circle, rgba(212, 175, 55, 0.04), transparent 60%);
  }

  @keyframes glowPulse {
    0% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.9); }
    100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.15); }
  }

  .hero-ambient-shift {
    position: absolute;
    inset: -50%;
    opacity: 0.3;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(212, 175, 55, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(15, 138, 107, 0.06) 0%, transparent 50%);
    animation: ambientDrift 12s ease-in-out infinite alternate;
  }
  :global([data-theme="light"]) .hero-ambient-shift {
    opacity: 0.15;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(200, 150, 14, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(26, 138, 107, 0.04) 0%, transparent 50%);
  }

  @keyframes ambientDrift {
    0% { transform: translate(0%, 0%) rotate(0deg); }
    50% { transform: translate(3%, -2%) rotate(3deg); }
    100% { transform: translate(-2%, 3%) rotate(-2deg); }
  }

  .hero-motif-dots {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    background-image:
      radial-gradient(circle at center, rgba(212, 175, 55, 0.08) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at center, rgba(212, 175, 55, 0.04) 0 1px, transparent 1.1px),
      radial-gradient(circle at center, rgba(15, 138, 107, 0.03) 0 2px, transparent 2.1px);
    background-size: 38px 38px, 38px 38px, 76px 76px;
    background-position: 0 0, 19px 19px, 38px 38px;
    -webkit-mask-image: radial-gradient(100% 80% at 50% 40%, #000 20%, transparent 75%);
    mask-image: radial-gradient(100% 80% at 50% 40%, #000 20%, transparent 75%);
  }
  :global([data-theme="light"]) .hero-motif-dots {
    background-image:
      radial-gradient(circle at center, rgba(40, 40, 40, 0.06) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at center, rgba(40, 40, 40, 0.03) 0 1px, transparent 1.1px),
      radial-gradient(circle at center, rgba(40, 40, 40, 0.02) 0 2px, transparent 2.1px);
    background-size: 38px 38px, 38px 38px, 76px 76px;
    background-position: 0 0, 19px 19px, 38px 38px;
  }

  .hero-sheen {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.15;
    background: linear-gradient(
      135deg,
      transparent 0%,
      rgba(212, 175, 55, 0.03) 30%,
      rgba(246, 241, 233, 0.04) 50%,
      rgba(212, 175, 55, 0.03) 70%,
      transparent 100%
    );
    animation: sheenSlide 8s ease-in-out infinite alternate;
  }
  :global([data-theme="light"]) .hero-sheen {
    opacity: 0.08;
    background: linear-gradient(
      135deg,
      transparent 0%,
      rgba(122, 92, 16, 0.02) 30%,
      rgba(42, 39, 34, 0.03) 50%,
      rgba(122, 92, 16, 0.02) 70%,
      transparent 100%
    );
  }

  @keyframes sheenSlide {
    0% { transform: translateX(-30%) translateY(-20%) rotate(-15deg); }
    100% { transform: translateX(30%) translateY(20%) rotate(15deg); }
  }

  .hero-ambient-shift {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 40%, transparent 0%, rgba(7, 7, 7, 0.5) 60%, rgba(7, 7, 7, 0.85) 100%),
      linear-gradient(to bottom, rgba(7, 7, 7, 0.4) 0%, transparent 35%, rgba(7, 7, 7, 0.6) 70%, rgba(7, 7, 7, 0.95) 100%);
    pointer-events: none;
    transition: background 0.8s ease;
  }

  :global([data-theme="light"]) .hero-gradient-overlay {
    background:
      radial-gradient(ellipse at 50% 40%, transparent 0%, rgba(232, 224, 214, 0.4) 60%, rgba(232, 224, 214, 0.7) 100%),
      linear-gradient(to bottom, rgba(232, 224, 214, 0.2) 0%, transparent 35%, rgba(232, 224, 214, 0.5) 70%, rgba(232, 224, 214, 0.9) 100%);
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    pointer-events: none;
    padding: 2rem;
  }

  .hero-text-wrapper {
    max-width: 900px;
    position: relative;
  }

  .hero-eyebrow-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hero-eyebrow-line {
    display: block;
    width: clamp(2rem, 5vw, 4rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    opacity: 0.5;
  }
  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: clamp(0.7rem, 1.3vw, 0.85rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  :global([data-theme="light"]) .hero-eyebrow {
    color: #a67c00;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 8.5vw, 6rem);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--color-ivory);
    margin: 0 0 1.2rem 0;
    position: relative;
    text-shadow:
      0 0 40px rgba(212, 175, 55, 0.08),
      0 0 80px rgba(212, 175, 55, 0.04);
  }
  :global([data-theme="light"]) .hero-title {
    color: #1a1a1a;
    text-shadow:
      0 0 40px rgba(122, 92, 16, 0.06),
      0 0 80px rgba(122, 92, 16, 0.03);
  }

  .title-decor {
    position: absolute;
    top: -0.8em;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.6;
  }
  .decor-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
  }
  .decor-dash {
    width: clamp(3rem, 8vw, 6rem);
    height: 1px;
    background: linear-gradient(90deg, var(--color-gold), transparent);
    opacity: 0.4;
  }
  
  .title-line {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.15em;
  }
  .title-char {
    display: inline-block;
    opacity: 0;
    animation: charPop 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .title-line.animate-glowing-type .title-char {
    opacity: 0;
    animation: charPop 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards, softGlowPulse 3s ease-in-out infinite alternate forwards;
  }
  .title-line.animate-glowing-type.delay-2 .title-char {
    animation: charPop 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards, softGlowPulse 3s ease-in-out infinite alternate forwards;
  }
  .title-char:nth-child(1) { animation-delay: 0.0s; }
  .title-char:nth-child(2) { animation-delay: 0.05s; }
  .title-char:nth-child(3) { animation-delay: 0.1s; }
  .title-char:nth-child(4) { animation-delay: 0.15s; }
  .title-char:nth-child(5) { animation-delay: 0.2s; }
  .title-char:nth-child(6) { animation-delay: 0.25s; }
  .title-char:nth-child(7) { animation-delay: 0.3s; }
  .title-char:nth-child(8) { animation-delay: 0.35s; }
  .title-char:nth-child(9) { animation-delay: 0.4s; }
  .title-char:nth-child(10) { animation-delay: 0.45s; }

  @keyframes charPop {
    0% { opacity: 0; transform: translateY(0.3em) scale(0.95); filter: blur(4px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }

  .italic-accent {
    font-style: italic;
    font-weight: 600;
    background: linear-gradient(135deg, #fbe7a2, var(--color-gold) 40%, #d4af37, #f4d878);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% 200%;
    animation: goldShimmer 4s ease-in-out infinite alternate;
  }
  :global([data-theme="light"]) .italic-accent {
    background: linear-gradient(135deg, #c49a00, #8a6a00 50%, #5c4700);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% 200%;
    animation: goldShimmer 4s ease-in-out infinite alternate;
  }

  @keyframes goldShimmer {
    0% { background-position: 0% 0%; }
    100% { background-position: 100% 100%; }
  }

  .title-accent-space {
    display: inline-block;
    width: 0.25em;
  }

  .hero-subtitle-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .subtitle-icon {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
    opacity: 0.4;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(212, 175, 55, 0.3);
  }
  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.6vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-ivory-dim);
    max-width: 520px;
    margin: 0;
  }
  :global([data-theme="light"]) .hero-subtitle {
    color: #4a4a4a;
  }

  .hero-cta {
    pointer-events: auto;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .hero-scroll-indicator span {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ivory-dim);
  }
  :global([data-theme="light"]) .hero-scroll-indicator span {
    color: #6a6a6a;
  }

  .mouse {
    width: 20px;
    height: 32px;
    border: 1.5px solid rgba(212, 175, 55, 0.35);
    border-radius: 10px;
    position: relative;
  }
  :global([data-theme="light"]) .mouse {
    border-color: rgba(166, 124, 0, 0.35);
  }
  .mouse::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 5px;
    background: var(--color-gold);
    border-radius: 2px;
    animation: scrollWheel 2s infinite;
  }
  :global([data-theme="light"]) .mouse::before {
    background: #a67c00;
  }

  .hero-corner-decor {
    position: absolute;
    width: clamp(1.5rem, 3vw, 3rem);
    height: clamp(1.5rem, 3vw, 3rem);
    pointer-events: none;
    opacity: 0.2;
    border-color: var(--color-gold);
  }
  .hero-corner-tl {
    top: 2rem; left: 2rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .hero-corner-tr {
    top: 2rem; right: 2rem;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .hero-corner-bl {
    bottom: 2rem; left: 2rem;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .hero-corner-br {
    bottom: 2rem; right: 2rem;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }
  :global([data-theme="light"]) .hero-corner-decor {
    border-color: #a67c00;
    opacity: 0.15;
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-glowing-type {
    opacity: 0;
    animation: typeReveal 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 1.5s ease-out forwards;
  }

  .delay-1 { animation-delay: 0.2s; }
  .delay-2 { animation-delay: 0.6s; }
  .delay-3 { animation-delay: 0.8s; }
  .delay-4 { animation-delay: 1.2s; }
  .delay-5 { animation-delay: 1.6s; }
  .delay-6 { animation-delay: 2.0s; }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes typeReveal {
    0% { opacity: 0; clip-path: polygon(0 0, 0 0, 0 100%, 0% 100%); transform: translateX(-10px); }
    1% { opacity: 1; }
    100% { opacity: 1; clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%); transform: translateX(0); }
  }
  @keyframes softGlowPulse {
    0% { filter: brightness(1) drop-shadow(0 0 0px rgba(212, 175, 55, 0)); }
    50% { filter: brightness(1.2) drop-shadow(0 0 6px rgba(212, 175, 55, 0.15)); }
    100% { filter: brightness(1.35) drop-shadow(0 0 12px rgba(212, 175, 55, 0.1)); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes scrollWheel {
    0% { transform: translate(-50%, 0); opacity: 1; }
    100% { transform: translate(-50%, 12px); opacity: 0; }
  }

  /* ===== BRIDGE SECTION ===== */
  .bridge-section {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 6vh, 5rem) clamp(1.25rem, 5vw, 3rem);
    background: linear-gradient(
      180deg,
      #070707 0%,
      rgba(9, 9, 9, 0.85) 20%,
      rgba(14, 14, 14, 0.7) 50%,
      var(--color-ink-2) 100%
    );
    z-index: 1;
    transition: background 0.8s ease;
  }
  :global([data-theme="light"]) .bridge-section {
    background: linear-gradient(
      180deg,
      #e8e0d6 0%,
      rgba(237, 230, 220, 0.85) 20%,
      rgba(248, 246, 243, 0.7) 50%,
      var(--color-ink-2) 100%
    );
  }

  .bridge-bg-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bridge-glow {
    position: absolute;
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    max-height: 500px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.1), transparent 70%);
    filter: blur(80px);
  }
  :global([data-theme="light"]) .bridge-glow {
    background: radial-gradient(circle, rgba(212, 175, 55, 0.06), transparent 70%);
  }
  .bridge-motif-dots {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image:
      radial-gradient(circle at center, rgba(212, 175, 55, 0.06) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at center, rgba(212, 175, 55, 0.03) 0 1px, transparent 1.1px);
    background-size: 38px 38px, 38px 38px;
    background-position: 0 0, 19px 19px;
  }
  :global([data-theme="light"]) .bridge-motif-dots {
    background-image:
      radial-gradient(circle at center, rgba(40, 40, 40, 0.04) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at center, rgba(40, 40, 40, 0.02) 0 1px, transparent 1.1px);
  }
  .bridge-grid {
    position: absolute;
    inset: 0;
    opacity: 0.2;
    background-image:
      linear-gradient(rgba(246, 241, 233, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(246, 241, 233, 0.02) 1px, transparent 1px);
    background-size: 90px 90px;
  }
  :global([data-theme="light"]) .bridge-grid {
    background-image:
      linear-gradient(rgba(42, 39, 34, 0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(42, 39, 34, 0.015) 1px, transparent 1px);
    background-size: 90px 90px;
  }

  .bridge-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 2vh, 1.5rem);
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  .bridge-ornament {
    opacity: 0.5;
    transform: scale(0.7);
  }
  .bridge-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    color: var(--color-ivory-dim);
    line-height: 1.6;
    max-width: 40ch;
  }
  :global([data-theme="light"]) .bridge-text {
    color: #4a4a4a;
  }
  .bridge-rule {
    width: clamp(4rem, 12vw, 8rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), transparent);
    margin-top: 0.5rem;
  }

  @media (max-width: 540px) {
    .hero-title {
      font-size: clamp(2rem, 12vw, 3rem);
    }
    .hero-eyebrow-wrapper {
      gap: 0.6rem;
    }
    .hero-eyebrow-line {
      width: 1.5rem;
    }
    .hero-corner-decor {
      display: none;
    }
    .bridge-section {
      padding: clamp(2rem, 4vh, 3rem) 1.1rem;
    }
    .bridge-ornament {
      transform: scale(0.55);
    }
  }
</style>

<script>
  const initCanvas = () => {
    const canvas = document.getElementById('motif-canvas') as HTMLCanvasElement;
    const container = document.getElementById('hero');
    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d', { alpha: true }); 
    if (!ctx) return;

    let w = canvas.width = window.innerWidth;
    let h = canvas.height = window.innerHeight;
    let cx = w / 2;
    let cy = h / 2;

    let mouse = { x: -1000, y: -1000, radius: 160 };

    const generateMotifPoints = (motifType: 'semanggi' | 'sawunggaling' | 'pesisir' | 'tunjungan', numPoints: number) => {
      const points: { x: number; y: number; isAccent?: boolean }[] = [];
      const scale = Math.min(w, h) * 0.38;

      for (let i = 0; i < numPoints; i++) {
        const t = (i / numPoints) * Math.PI * 2;
        let px = 0, py = 0;
        let isAccent = false;

        if (motifType === 'semanggi') {
          const r1 = Math.abs(Math.sin(2 * t)) * scale;
          const r2 = Math.abs(Math.sin(4 * t)) * scale * 0.3;
          const r = r1 + r2 + (Math.random() * 15 - 7);
          px = cx + Math.cos(t) * r;
          py = cy + Math.sin(t) * r;
          isAccent = Math.abs(Math.sin(4 * t)) > 0.7;
        } else if (motifType === 'sawunggaling') {
          const rBase = (Math.abs(Math.sin(3 * t)) * 0.5 + Math.abs(Math.cos(2 * t)) * 0.5) * scale;
          const comb = Math.abs(Math.sin(t * 6)) * scale * 0.15;
          const r = rBase + comb + (Math.random() * 14 - 7);
          px = cx + Math.cos(t) * r;
          py = cy + Math.sin(t) * r;
          isAccent = Math.abs(Math.sin(3 * t)) > 0.8;
        } else if (motifType === 'pesisir') {
          const angle = t * 4;
          const rBase = (angle / (Math.PI * 8)) * scale * 1.3;
          const wave = Math.sin(angle * 6) * 18;
          const fringe = Math.abs(Math.sin(t * 8)) * scale * 0.08;
          const r = rBase + wave + fringe + (Math.random() * 12 - 6);
          px = cx + Math.cos(angle) * r;
          py = cy + Math.sin(angle) * r;
          isAccent = Math.sin(angle * 6) > 0.6;
        } else if (motifType === 'tunjungan') {
          const r = (Math.abs(Math.sin(t * 1.5)) * 0.4 + Math.abs(Math.cos(t * 3)) * 0.6) * scale + (Math.random() * 16 - 8);
          const tilt = Math.sin(t * 5) * 18;
          const petal = Math.abs(Math.cos(t * 4)) * scale * 0.2;
          px = cx + Math.cos(t) * (r + petal) + tilt;
          py = cy + Math.sin(t) * r * 0.8 + Math.cos(t * 2) * 14;
          isAccent = Math.abs(Math.cos(t * 4)) > 0.7;
        }
        
        points.push({ x: px, y: py, isAccent });
      }
      return points;
    };

    const motifs: ('semanggi' | 'sawunggaling' | 'pesisir' | 'tunjungan')[] = ['semanggi', 'sawunggaling', 'pesisir', 'tunjungan'];
    let motifIndex = 0;
    const numParticles = Math.min(Math.floor((w * h) / 3200), 450);
    let targetPoints = generateMotifPoints(motifs[0], numParticles);

    setInterval(() => {
      motifIndex = (motifIndex + 1) % motifs.length;
      targetPoints = generateMotifPoints(motifs[motifIndex], numParticles);
      targetPoints.sort(() => Math.random() - 0.5);
    }, 8000);

    const resize = () => {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
      cx = w / 2;
      cy = h / 2;
      targetPoints = generateMotifPoints(motifs[motifIndex], numParticles);
    };
    window.addEventListener('resize', resize, { passive: true });

    container.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    }, { passive: true });

    container.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    class MotifParticle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      friction: number;
      ease: number;
      angle: number;
      isAccent: boolean;

      constructor(x: number, y: number, isAccent: boolean = false) {
        this.x = x;
        this.y = y;
        this.vx = 0;
        this.vy = 0;
        this.size = isAccent ? (Math.random() * 1.8 + 1.2) : (Math.random() * 1.2 + 0.6);
        this.friction = Math.random() * 0.04 + 0.92;
        this.ease = Math.random() * 0.02 + 0.02;
        this.angle = Math.random() * Math.PI * 2;
        this.isAccent = isAccent;
      }

      update(targetX: number, targetY: number) {
        this.angle += (Math.random() - 0.5) * 0.3;
        const wanderX = Math.cos(this.angle) * 1.2;
        const wanderY = Math.sin(this.angle) * 1.2;

        let dx = (targetX + wanderX) - this.x;
        let dy = (targetY + wanderY) - this.y;

        this.vx += dx * this.ease;
        this.vy += dy * this.ease;

        const mdx = this.x - mouse.x;
        const mdy = this.y - mouse.y;
        const dist = Math.sqrt(mdx * mdx + mdy * mdy);

        if (dist < mouse.radius) {
          const force = (mouse.radius - dist) / mouse.radius;
          this.vx += (mdx / dist) * force * 18;
          this.vy += (mdy / dist) * force * 18;
        }

        this.vx *= this.friction;
        this.vy *= this.friction;
        this.x += this.vx;
        this.y += this.vy;
      }

      draw(ctx: CanvasRenderingContext2D, isLightMode: boolean) {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);

        if (isLightMode) {
          const base = this.isAccent ? '15, 138, 107' : '40, 40, 40';
          ctx.fillStyle = `rgba(${base}, ${this.isAccent ? 0.6 : 0.7})`;
        } else {
          const base = this.isAccent ? '15, 138, 107' : '212, 175, 55';
          ctx.fillStyle = `rgba(${base}, ${this.isAccent ? 0.7 : 0.8})`;
        }
        ctx.fill();
      }
    }

    const particles: MotifParticle[] = [];
    for (let i = 0; i < numParticles; i++) {
      const isAccent = targetPoints[i]?.isAccent || false;
      particles.push(new MotifParticle(Math.random() * w, Math.random() * h, isAccent));
    }

    const cellSize = 50;
    const buildGrid = () => {
      const grid = new Map<number, number[]>();
      const cols = Math.ceil(w / cellSize);
      particles.forEach((p, i) => {
        const gx = Math.floor(p.x / cellSize);
        const gy = Math.floor(p.y / cellSize);
        const key = gy * cols + gx;
        if (!grid.has(key)) grid.set(key, []);
        grid.get(key)!.push(i);
      });
      return grid;
    };

    let glowA = document.getElementById('hero-glow-a');
    let glowB = document.getElementById('hero-glow-b');

    const MAX_DIST = 2500;
    const accentColor = (isLight: boolean) => isLight
      ? [15, 138, 107] as const
      : [15, 138, 107] as const;
    const normalColor = (isLight: boolean) => isLight
      ? [40, 40, 40] as const
      : [212, 175, 55] as const;

    const accentOpacity = (dist: number) => 0.2 - dist / 12500;
    const normalOpacity = (dist: number) => 0.12 - dist / 20833;

    let animationFrame: number;
    const animate = () => {
      ctx.clearRect(0, 0, w, h);

      const isLightMode = document.documentElement.getAttribute('data-theme') === 'light';
      const grid = buildGrid();
      const cols = Math.ceil(w / cellSize);
      const connected = new Set<string>();
      const accentLines: Array<[number, number, number, number]> = [];
      const normalLines: Array<[number, number, number, number]> = [];

      if (glowA && glowB) {
        const gx = (mouse.x / w) * 10 - 5;
        const gy = (mouse.y / h) * 10 - 5;
        glowA.style.transform = `translate(${gx * 0.5}px, ${gy * 0.5}px)`;
        glowB.style.transform = `translate(${gx * -0.3}px, ${gy * -0.3}px)`;
      }

      particles.forEach((p, index) => {
        const target = targetPoints[index] || { x: cx, y: cy };
        p.update(target.x, target.y);
        p.draw(ctx, isLightMode);

        const gx = Math.floor(p.x / cellSize);
        const gy = Math.floor(p.y / cellSize);
        for (let dy = -1; dy <= 1; dy++) {
          for (let dx = -1; dx <= 1; dx++) {
            const key = (gy + dy) * cols + (gx + dx);
            const neighbors = grid.get(key);
            if (!neighbors) continue;
            for (const ni of neighbors) {
              if (ni <= index) continue;
              const key2 = `${index}-${ni}`;
              if (connected.has(key2)) continue;
              const p2 = particles[ni];
              const dx2 = p.x - p2.x;
              const dy2 = p.y - p2.y;
              const dist = dx2 * dx2 + dy2 * dy2;
              if (dist < MAX_DIST) {
                connected.add(key2);
                if (p.isAccent || p2.isAccent) {
                  accentLines.push([p.x, p.y, p2.x, p2.y]);
                } else {
                  normalLines.push([p.x, p.y, p2.x, p2.y]);
                }
              }
            }
          }
        }
      });

      if (accentLines.length > 0) {
        ctx.beginPath();
        for (const [x1, y1, x2, y2] of accentLines) {
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
        }
        ctx.strokeStyle = isLightMode
          ? `rgba(15, 138, 107, 0.1)`
          : `rgba(15, 138, 107, 0.12)`;
        ctx.stroke();
      }
      if (normalLines.length > 0) {
        ctx.beginPath();
        for (const [x1, y1, x2, y2] of normalLines) {
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
        }
        ctx.strokeStyle = isLightMode
          ? `rgba(40, 40, 40, 0.06)`
          : `rgba(212, 175, 55, 0.08)`;
        ctx.stroke();
      }

      animationFrame = requestAnimationFrame(animate);
    };

    animate();

    return () => {
      window.removeEventListener('resize', resize);
      cancelAnimationFrame(animationFrame);
    };
  };

  document.addEventListener('DOMContentLoaded', () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      requestAnimationFrame(() => requestAnimationFrame(initCanvas));
    }
  });
</script>
