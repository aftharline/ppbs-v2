---
/**
 * Navbar.astro — simplified navigation.
 * - Simple fixed header, no scroll hide/show logic (deferred)
 * - Mobile overlay with basic toggle (deferred)
 * - All heavy JS deferred to user interaction
 */
const links = [
  { label: "Tentang", href: "#about" },
  { label: "Visi", href: "#vision" },
  { label: "Sang Penjaga", href: "#guardians" },
  { label: "Perjalanan", href: "#journey" },
  { label: "Program", href: "#programs" },
  { label: "Struktur", href: "#structure" },
  { label: "Mitra", href: "#partnership" },
  { label: "Galeri", href: "#gallery" },
  { label: "Kolaborasi", href: "#collaboration" },
];
---

<header class="nav" id="nav" data-nav aria-label="Navigasi utama" style="transform: translateY(-150%);">
  <nav class="nav-bar" aria-label="Navigasi">
    <a href="#about" class="brand" data-cursor>
      <span class="brand-mark" aria-hidden="true">
        <img src="/logo.svg" alt="Logo Putera Puteri Batik Surabaya" width="32" height="32" />
      </span>
      <span class="brand-text">
        <span class="brand-name">Putera Puteri</span>
        <span class="brand-sub">Batik Surabaya</span>
      </span>
    </a>

    <ul class="nav-links">
      {links.map((l) => (
        <li><a href={l.href} data-cursor>{l.label}</a></li>
      ))}
    </ul>

    <a href="#register" class="nav-cta" data-cursor>
      <span>Daftar Sekarang</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>

    <button class="nav-burger" id="nav-burger" aria-label="Buka menu" aria-expanded="false" aria-controls="nav-overlay">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<!-- Mobile fullscreen overlay -->
<div class="overlay" id="nav-overlay" aria-hidden="true">
  <div class="overlay-panel">
    <div class="overlay-brand">
      <span>Putera Puteri</span>
      <strong>Batik Surabaya</strong>
    </div>
    <ul class="overlay-links">
      {links.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={l.href} data-overlay-link>
            <span>{String(i + 1).padStart(2, "0")}</span>
            {l.label}
          </a>
        </li>
      ))}
      <li class="overlay-cta-li" style={`--i:${links.length}`}>
        <a href="#register" class="overlay-cta" data-overlay-link>
          <span>{String(links.length + 1).padStart(2, "0")}</span>
          Daftar Sekarang
        </a>
      </li>
    </ul>
    <p class="overlay-note">Wujud tresna budaya arek Surabaya.</p>
  </div>
</div>

<style>
  /* ============ BAR ============ */
  .nav {
    position: fixed;
    top: 0;
    left: 0; right: 0;
    z-index: 100;
    padding: 0.5rem clamp(1rem, 3vw, 2.5rem);
    transform: translateY(-150%);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav.is-visible {
    transform: translateY(0) !important;
  }
  .nav-bar {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: 18px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
    box-shadow:
      inset 0 1px 0 0 var(--glass-highlight),
      0 24px 60px -28px rgba(0, 0, 0, 0.85);
  }

  /* ============ BRAND ============ */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    color: var(--color-gold);
    background: radial-gradient(circle at 30% 25%, rgba(212,175,55,0.18), rgba(212,175,55,0.02));
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: 12px;
    transition: transform 0.6s var(--ease-lux);
  }
  .brand:hover .brand-mark { transform: rotate(72deg) scale(1.05); }
  .brand-text { display: flex; flex-direction: column; line-height: 1; }
  .brand-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.02rem;
    color: var(--color-ivory);
    letter-spacing: -0.01em;
  }
  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-top: 3px;
    font-weight: 600;
  }

  /* ============ LINKS ============ */
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.8vw, 1.9rem);
  }
  .nav-links a {
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ivory-dim);
    transition: color 0.3s var(--ease-smooth);
    position: relative;
    padding: 0.2rem 0;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 50%; bottom: -2px;
    width: 0; height: 1px;
    background: var(--color-gold);
    transition: width 0.4s var(--ease-lux), left 0.4s var(--ease-lux);
  }
  .nav-links a:hover { color: var(--color-ivory); }
  .nav-links a:hover::after { width: 100%; left: 0; }

  /* ============ CTA ============ */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #f4d878, var(--color-gold) 55%, var(--color-bronze));
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 10px 30px -12px rgba(212, 175, 55, 0.6);
    transition: box-shadow 0.4s var(--ease-lux);
  }
  .nav-cta:hover {
    box-shadow: 0 14px 40px -10px rgba(212, 175, 55, 0.75);
  }

  /* ============ BURGER ============ */
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 42px; height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    cursor: pointer;
    transition: border-color 0.3s var(--ease-lux), background 0.3s var(--ease-lux);
  }
  .nav-burger:hover {
    border-color: rgba(212, 175, 55, 0.4);
    background: rgba(246, 241, 233, 0.08);
  }
  .nav-burger.is-open {
    border-color: rgba(212, 175, 55, 0.3);
  }
  .nav-burger span {
    display: block;
    width: 20px; height: 1.6px;
    background: var(--color-ivory);
    border-radius: 2px;
    transition: transform 0.4s var(--ease-lux), opacity 0.3s;
  }
  .nav-burger.is-open span:nth-child(1) { transform: translateY(6.6px) rotate(45deg); }
  .nav-burger.is-open span:nth-child(2) { opacity: 0; }
  .nav-burger.is-open span:nth-child(3) { transform: translateY(-6.6px) rotate(-45deg); }
  .nav-burger:hover {
    border-color: rgba(212, 175, 55, 0.4);
    background: rgba(246, 241, 233, 0.08);
  }
  .nav-burger.is-open {
    border-color: rgba(212, 175, 55, 0.3);
  }
  .nav-burger span {
    display: block;
    width: 20px; height: 1.6px;
    background: var(--color-ivory);
    border-radius: 2px;
    transition: transform 0.4s var(--ease-lux), opacity 0.3s;
  }
  .nav-burger.is-open span:nth-child(1) { transform: translateY(6.6px) rotate(45deg); }
  .nav-burger.is-open span:nth-child(2) { opacity: 0; }
  .nav-burger.is-open span:nth-child(3) { transform: translateY(-6.6px) rotate(-45deg); }

  /* ============ OVERLAY (mobile) ============ */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    background:
      radial-gradient(90% 70% at 50% 0%, rgba(212, 175, 55, 0.15), transparent 58%),
      radial-gradient(70% 70% at 8% 92%, rgba(15, 138, 107, 0.15), transparent 62%),
      rgba(7, 7, 7, 0.95);
    -webkit-backdrop-filter: blur(28px) saturate(120%);
    backdrop-filter: blur(28px) saturate(120%);
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-lux), visibility 0.6s;
    padding: env(safe-area-inset-top) 1.5rem env(safe-area-inset-bottom);
  }
  .overlay.is-open { opacity: 1; visibility: visible; }
  .overlay::before {
    content: "";
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.16);
    pointer-events: none;
  }
  .overlay-panel {
    position: relative;
    width: min(88vw, 520px);
    padding: clamp(1.4rem, 6vw, 2.2rem);
    border: 1px solid var(--glass-border);
    background:
      linear-gradient(180deg, var(--glass-highlight), transparent),
      var(--glass-bg);
    box-shadow: 0 28px 80px -34px rgba(0, 0, 0, 0.9);
    transform: translateY(18px) scale(0.98);
    transition: transform 0.75s var(--ease-lux);
  }
  .overlay.is-open .overlay-panel { transform: none; }
  .overlay-brand {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.8rem, 7vw, 3rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
  }
  .overlay-brand span {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.2rem, 5vw, 1.8rem);
  }
  .overlay-brand strong {
    color: var(--color-gold);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .overlay-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
  }
  .overlay-links li {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-lux), transform 0.6s var(--ease-lux);
    transition-delay: calc(var(--i) * 0.06s);
  }
  .overlay.is-open .overlay-links li { opacity: 1; transform: none; }
  .overlay-links a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.65rem 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.55rem, 7.5vw, 2.65rem);
    color: var(--color-ivory);
    font-variation-settings: "opsz" 120, "WONK" 1;
    transition: color 0.35s var(--ease-lux), transform 0.35s var(--ease-lux);
    border-bottom: 1px solid var(--glass-border);
  }
  .overlay-links a span {
    order: 2;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    color: var(--color-gold);
  }
  .overlay-links a:hover {
    color: var(--color-gold);
    transform: translateX(6px);
  }
  .overlay-cta {
    margin-top: 0.6rem;
    color: var(--color-gold) !important;
    font-style: italic;
  }
  .overlay-note {
    margin-top: clamp(1.6rem, 6vw, 2.6rem);
    color: var(--color-ivory-dim);
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .nav-links, .nav-cta { display: none; }
    .nav-burger { display: flex; }
  }
  @media (min-width: 901px) {
    .nav-bar { padding: 0.65rem 0.65rem 0.65rem 1.25rem; }
  }
  @media (max-width: 430px) {
    .nav { padding: 0 0.9rem; }
    .nav-bar { padding: 0.45rem 0.45rem 0.45rem 0.9rem; border-radius: 18px; }
    .brand-mark { width: 34px; height: 34px; }
    .brand-name { font-size: 0.9rem; }
    .brand-sub { display: block; font-size: 0.52rem; letter-spacing: 0.18em; }
    .nav-burger { width: 38px; height: 38px; }
    .overlay-panel { margin-top: 2rem; }
  }
  @media (max-width: 360px) {
    .brand-name { font-size: 0.82rem; }
    .brand-sub { font-size: 0.48rem; letter-spacing: 0.12em; }
  }
</style>

<script>
  // Auto-hide/reveal logic for Navbar using native IntersectionObserver
  // High performance, 0 dependencies
  const navElement = document.getElementById("nav");
  const aboutSection = document.getElementById("about");
  
  if (navElement && aboutSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // If the about section is intersecting (in view), show the navbar
          // Otherwise hide it (when user scrolls back up to hero)
          if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
            navElement.classList.add("is-visible");
          } else {
            navElement.classList.remove("is-visible");
          }
        });
      },
      {
        root: null,
        rootMargin: "-50px 0px 0px 0px", // Trigger slightly after crossing the threshold
        threshold: 0
      }
    );
    
    observer.observe(aboutSection);
  }

  // Simple mobile menu toggle - NO scroll logic, NO Lenis integration here
  // All heavy JS deferred to user interaction via index.astro
  const burger = document.getElementById("nav-burger");
  const overlay = document.getElementById("nav-overlay");

  if (burger && overlay) {
    burger.addEventListener("click", () => {
      const open = !overlay.classList.contains("is-open");
      overlay.classList.toggle("is-open", open);
      overlay.setAttribute("aria-hidden", open ? "false" : "true");
      burger.setAttribute("aria-expanded", open ? "true" : "false");
      burger.classList.toggle("is-open", open);
    });

    overlay.querySelectorAll("[data-overlay-link]").forEach((a) =>
      a.addEventListener("click", () => {
        overlay.classList.remove("is-open");
        overlay.setAttribute("aria-hidden", "true");
        burger.setAttribute("aria-expanded", "false");
        burger.classList.remove("is-open");
      })
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        overlay.classList.remove("is-open");
        overlay.setAttribute("aria-hidden", "true");
        burger.setAttribute("aria-expanded", "false");
        burger.classList.remove("is-open");
      }
    });
  }
</script>